APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-local-only-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
POSTGRES_DB=arkatara
POSTGRES_USER=arkatara
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Task 3 media remains disabled until explicitly configured.
PRODUCT_MEDIA_STORAGE=UNCONFIGURED
# LOCAL is restricted to local/test. Set a dedicated absolute directory outside Git.
# PRODUCT_MEDIA_ROOT=
# Set an explicit reviewed positive byte limit and MIME allowlist; no defaults selected.
# PRODUCT_MEDIA_MAX_BYTES=
# PRODUCT_MEDIA_ALLOWED_TYPES=
